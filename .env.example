# ==============================================================================
# Fashion VISTA - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# For Production: Configure these variables in Vercel (Frontend) and Render (Backend).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel & Local Vite)
# ------------------------------------------------------------------------------
# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key-here

# Backend Flask ML Service Base URL:
# - For Local Dev: http://localhost:5000/api
# - For Production on Vercel: https://fashion-vista-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: Redirect URL for Supabase Email Confirmation
# - For Local Dev: http://localhost:5173/auth/confirm
# - For Production on Vercel: https://your-project.vercel.app/auth/confirm
# VITE_SUPABASE_REDIRECT_URL=https://your-project.vercel.app/auth/confirm

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render & Local Flask)
# ------------------------------------------------------------------------------
# Allowed CORS Origins (comma-separated domains allowed to call the Flask API)
# In production on Render: set to your Vercel URL (e.g. https://your-app.vercel.app)
ALLOWED_ORIGINS=*

# Backend Supabase verification variables (optional; defaults to VITE_SUPABASE_* if present)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key-here

# ------------------------------------------------------------------------------
# 3. AI VIRTUAL TRY-ON CONFIGURATION (IDM-VTON Pretrained Generative Engine)
# ------------------------------------------------------------------------------
# Provider: 'hf_spaces' (default, uses ZeroGPU IDM-VTON reference endpoint)
#           'replicate' (uses Replicate hosted API)
#           'remote_worker' (uses custom GPU server URL)
VTON_PROVIDER=hf_spaces

# Optional Hugging Face Access Token (prevents rate-limiting on busy public spaces)
# Generate free token at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_hugging_face_token_here

# Optional IDM-VTON Space ID (defaults to reference space 'yisol/IDM-VTON')
IDM_VTON_SPACE=yisol/IDM-VTON

# ------------------------------------------------------------------------------
# 4. FITINVIEW AI VIRTUAL TRY-ON API CONFIGURATION
# ------------------------------------------------------------------------------
# FitInView Try-On API Key (Get from https://fitinview.com/developers)
# Use 'fiv_test_*' key for free testing (no credits deducted, echoes metadata)
# Use 'fiv_live_*' key for production 1K/2K/4K photorealistic generation
# FITINVIEW_API_KEY=fiv_live_your_fitinview_api_key_here

# FitInView Base API URL (defaults to production endpoint https://api.fitinview.com)
FITINVIEW_BASE_URL=https://api.fitinview.com

# Default output resolution: '1K' (8 credits, ~1024px), '2K' (12 credits), '4K' (20 credits)
FITINVIEW_OUTPUT_SIZE=1K
